# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtualenv
.venv/
venv/

# SQLite runtime files, AND the database itself: speiseplan.db is no
# longer version-controlled (see fixtures/demo_data.json +
# services/demo_seed.py instead) - a real deployment's actual data must
# never be able to end up committed here by accident.
instance/*.db
instance/*.db-journal
instance/*.db-wal
instance/*.db-shm

# Auto-generated Flask signing key (CSRF/sessions, see app.py:
# load_or_create_secret_key) - generated independently per environment,
# does NOT belong in the repo (otherwise all deployments could forge each
# other's tokens).
instance/secret_key

# Editor/OS
.DS_Store

# Local bug-tracking scratch file (see feedback_bugs_md_workflow memory) -
# not meant for the public repo, checked and cleared before every
# push/deploy instead.
BUGS.md
