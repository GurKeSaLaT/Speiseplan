msgid "Fixed Day Assignment"
msgstr "Feste Tageszuordnung"

#: templates/create_week.html:62
msgid "Clear All"
msgstr "Alles zurücksetzen"

#: templates/create_week.html:77
msgid "Exclude this day from planning"
msgstr "Diesen Tag von der Planung ausschließen"

#: templates/create_week.html:79
msgid "Fill in automatically"
